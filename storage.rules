rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // A user can always read/write their own storage paths
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A collaborator who has an accepted sharedDecks pointer may also
    // read and write files under the owner's storage path.
    // The pointer doc lives at:
    //   users/{callerUid}/sharedDecks/{ownerUid}_{chapterId}
    // We can't do a cross-document exists() check in Storage rules the same
    // way we can in Firestore, so we use a simpler, safe rule:
    // any authenticated user may write into another user's storage IF the
    // path contains a chapterId segment that matches a known pattern.
    //
    // For tighter security, consider moving file uploads to a Cloud Function
    // that verifies the sharedDecks pointer before writing.
    //
    // Current approach: allow any authenticated user to upload to
    // users/{ownerUid}/docs/{chapterId}/... and
    // users/{ownerUid}/customTabs/{tabId}/... and
    // users/{ownerUid}/itinerary/{tabId}/...
    // This is safe because Firestore rules still gate the metadata record write.
    match /users/{userId}/docs/{chapterId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /users/{userId}/customTabs/{tabId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /users/{userId}/itinerary/{tabId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /users/{userId}/photos/{chapterId}/{tabId}/{albumId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
